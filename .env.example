# Admin password (server-side, used by netlify/functions/verifyAdmin.js)
ADMIN_PASSWORD=your_admin_password
APP_SECRET=a_long_random_string

# Cash App cashtag (include the $) — e.g. $janedoe
VITE_CASHAPP_CASHTAG=

# Default amount in dollars to request — e.g. 40
VITE_CASHAPP_AMOUNT=

# Admin phone number for SMS payment link — e.g. +15555551234
VITE_ADMIN_PHONE=

# Same value as VITE_ADMIN_PHONE — used server-side as the SMS destination whitelist
ADMIN_PHONE=

# Same value as APP_SECRET — bundled into the client to gate the SMS endpoint
VITE_APP_SECRET=same_value_as_APP_SECRET

# Twilio credentials (used by netlify/functions/sendSms.js — server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
